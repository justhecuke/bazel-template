module(
    name = "bazel_template",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "0.37.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "aspect_rules_lint", version = "2.5.2")
bazel_dep(name = "ruff_prebuilt", version = "0.15.12.1", repo_name = "ruff")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "rules_python_gazelle_plugin", version = "0.37.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_cc", version = "0.2.17")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains("@zig_sdk//toolchain/...")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.13")
go_sdk.nogo(
    nogo = "//:nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "co_honnef_go_tools", "org_golang_x_tools")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.repository_set(
    name = "rust_windows_x86_64",
    edition = "2021",
    exec_compatible_with = ["@platforms//os:none"],
    exec_triple = "x86_64-pc-windows-msvc",
    target_compatible_with = ["@platforms//os:none"],
    target_triple = "x86_64-pc-windows-msvc",
    versions = ["1.85.0"],
)
rust.repository_set(
    name = "rust_windows_gnu_x86_64",
    edition = "2021",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    exec_triple = "x86_64-pc-windows-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    target_triple = "x86_64-pc-windows-gnu",
    versions = ["1.85.0"],
)
rust.toolchain(
    edition = "2021",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//patches:rules_rust_windows_gnu.patch",
        "//patches:rules_rust_cdylib_windows.patch",
    ],
)
