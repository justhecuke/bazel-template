    name = "pyrefly",
    srcs = ["pyrefly.py"],
    data = ["@pip//pyrefly:extracted_whl_files"],
    main = "pyrefly.py",
    visibility = ["//visibility:public"],
    deps = ["@pip//pyrefly"],
)

