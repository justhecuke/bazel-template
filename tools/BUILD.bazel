    visibility = ["//visibility:public"],
)

alias(
    name = "rustfmt",
    actual = "@rules_rust//tools/upstream_wrapper:rustfmt",
    visibility = ["//visibility:public"],
)

alias(
    name = "cargo",
    actual = "@rules_rust//tools/upstream_wrapper:cargo",
    visibility = ["//visibility:public"],
)
