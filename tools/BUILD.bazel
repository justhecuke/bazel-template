load("@rules_python//python:defs.bzl", "py_binary")

alias(
    name = "ruff",
    actual = "@ruff//:ruff",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "ruff_cli",
    srcs = ["run_in_cwd.py"],
    args = ["$(rlocationpath @ruff//:ruff)"],
    data = ["@ruff"],
    main = "run_in_cwd.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "buildifier",
    srcs = ["run_in_cwd.py"],
    args = ["$(rlocationpath @buildifier_prebuilt//:buildifier)"],
    data = ["@buildifier_prebuilt//:buildifier"],
    main = "run_in_cwd.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "buildozer",
    srcs = ["run_in_cwd.py"],
    args = ["$(rlocationpath @buildifier_prebuilt//:buildozer)"],
    data = ["@buildifier_prebuilt//:buildozer"],
    main = "run_in_cwd.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "pyrefly",
    srcs = ["pyrefly.py"],
    data = ["@pip//pyrefly:extracted_whl_files"],
    main = "pyrefly.py",
    visibility = ["//visibility:public"],
    deps = ["@pip//pyrefly"],
)

py_binary(
    name = "goimports",
    srcs = ["run_in_cwd.py"],
    args = ["$(rlocationpath @org_golang_x_tools//cmd/goimports:goimports)"],
    data = ["@org_golang_x_tools//cmd/goimports"],
    main = "run_in_cwd.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "staticcheck",
    srcs = ["run_in_cwd.py"],
    args = ["$(rlocationpath @co_honnef_go_tools//cmd/staticcheck:staticcheck)"],
    data = ["@co_honnef_go_tools//cmd/staticcheck"],
    main = "run_in_cwd.py",
    visibility = ["//visibility:public"],
)

alias(
    name = "rustfmt",
    actual = "@rules_rust//tools/upstream_wrapper:rustfmt",
    visibility = ["//visibility:public"],
)

alias(
    name = "cargo",
    actual = "@rules_rust//tools/upstream_wrapper:cargo",
    visibility = ["//visibility:public"],
)
