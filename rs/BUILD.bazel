load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")

rust_library(
    name = "calculator",
    srcs = ["calculator.rs"],
    edition = "2021",
    visibility = ["//:__subpackages__"],
)

rust_shared_library(
    name = "rust_calculator",
    srcs = ["rust_calculator.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [":calculator"],
)

rust_library(
    name = "cpp_calculator",
    srcs = ["cpp_calculator.rs"],
    edition = "2021",
    link_deps = ["//cc:calculator"],
    visibility = ["//:__subpackages__"],
)

rust_binary(
    name = "main",
    srcs = ["main.rs"],
    edition = "2021",
    visibility = ["//:__subpackages__"],
    deps = [
        ":calculator",
        ":cpp_calculator",
    ],
)

rust_test(
    name = "calculator_test",
    srcs = ["calculator_test.rs"],
    edition = "2021",
    deps = [":calculator"],
)

rust_test(
    name = "cpp_calculator_test",
    srcs = ["cpp_calculator_test.rs"],
    edition = "2021",
    deps = [":cpp_calculator"],
)
