load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "calculator",
    srcs = ["calculator.cc"],
    hdrs = ["calculator.hh"],
    copts = [
        "-fno-exceptions",
        "-fno-rtti",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "rust_calculator",
    srcs = ["rust_calculator.cc"],
    hdrs = ["rust_calculator.hh"],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = ["//rs:rust_calculator"],
)

cc_binary(
    name = "main",
    srcs = ["main.cc"],
    data = ["//rs:rust_calculator"],
    env = select({
        "@platforms//os:windows": {
            "PATH": "rs;.",
        },
        "@platforms//os:linux": {
            "LD_LIBRARY_PATH": "rs:.",
        },
        "//conditions:default": {},
    }),
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,-rpath,$$ORIGIN/../rs",
            "-Wl,-rpath,$$ORIGIN/rs",
            "-Wl,-rpath,$$ORIGIN",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        ":calculator",
        ":rust_calculator",
        "//rs:rust_calculator",
    ],
)

cc_test(
    name = "calculator_test",
    srcs = ["calculator_test.cc"],
    linkstatic = True,
    deps = [":calculator"],
)

cc_test(
    name = "rust_calculator_test",
    srcs = ["rust_calculator_test.cc"],
    data = ["//rs:rust_calculator"],
    env = select({
        "@platforms//os:windows": {
            "PATH": "rs;.",
        },
        "@platforms//os:linux": {
            "LD_LIBRARY_PATH": "rs:.",
        },
        "//conditions:default": {},
    }),
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,-rpath,$$ORIGIN/../rs",
            "-Wl,-rpath,$$ORIGIN/rs",
            "-Wl,-rpath,$$ORIGIN",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    deps = [
        ":rust_calculator",
        "//rs:rust_calculator",
    ],
)
