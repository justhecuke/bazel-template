load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# gazelle:python_generation_mode file

py_library(
    name = "calculator",
    srcs = ["calculator.py"],
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":calculator",
        "@pip//cyclopts",
        "@pip//requests",
    ],
)

py_test(
    name = "calculator_test",
    srcs = ["calculator_test.py"],
    deps = [":calculator"],
)

# gazelle:exclude testdata

filegroup(
    name = "testdata",
    srcs = glob(["testdata/*"]),
)

py_test(
    name = "mise_test",
    srcs = ["mise_test.py"],
    data = ["//:.mise.toml"],
)

py_test(
    name = "wrappers_test",
    srcs = ["wrappers_test.py"],
    data = [
        ":testdata",
        "//bin:bin_scripts",
    ],
)
